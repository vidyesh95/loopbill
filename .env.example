# Local SQLite file (default). For Vercel, use a Turso libsql URL instead.
TURSO_DATABASE_URL=
# Required for remote Turso. Leave empty for a local file.
TURSO_AUTH_TOKEN=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32-character-or-longer-secret
BETTER_AUTH_URL=http://localhost:3000
