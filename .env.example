# Local SQLite file (default). For Vercel, use a Turso libsql URL instead.
TURSO_DATABASE_URL=
# Required for remote Turso. Leave empty for a local file.
TURSO_AUTH_TOKEN=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32-character-or-longer-secret
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Website contact / quote emails (optional). Leads are still saved if these are empty.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Vercel Blob for service proof photos (optional locally — falls back to public/uploads).
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/lifecycle. Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
